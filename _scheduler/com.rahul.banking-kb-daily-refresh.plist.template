<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the Indian-banking knowledge-base daily refresh.

  Schedule policy (fixed, not configurable):
    Every day, fires hourly at 10:00, 11:00, 12:00, 13:00, 14:00 and 15:00
    local time. The wrapper run_daily.sh implements first-success-wins via
    a per-day flag file (_logs/.success_YYYY-MM-DD.flag) so only the first
    successful fire of the day actually runs the engine; the remaining 5
    fires that day cost almost nothing (~30ms — they read the flag, log a
    skip message, and exit).

  Why this shape (vs. one fire at e.g. 10:00 only):
    - Bank IR sites are flaky around regulatory-filing days (NSE block
      windows, Akamai rate-limits, AEM cache invalidations). One firing
      per day means one bad day costs us 24h of staleness.
    - 10:00 IST is the earliest reasonable hour (most banks file before
      market open); 15:00 IST is the latest before the trading day ends.
    - Six attempts in a 6-hour window is generous without being abusive.

  Template placeholders rendered by install.sh:
    __KB_ROOT__     – absolute path to the KnowledgeBase folder
    __PYTHON_BIN__  – absolute path to a python3 with the engine's deps

  The rendered plist lives at
    ~/Library/LaunchAgents/com.rahul.banking-kb-daily-refresh.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rahul.banking-kb-daily-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__KB_ROOT__/_engine/_scheduler/run_daily.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>KB_ROOT</key>
        <string>__KB_ROOT__</string>
        <key>PYTHON_BIN</key>
        <string>__PYTHON_BIN__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!--
      StartCalendarInterval entries without a Weekday key fire EVERY day.
      Six entries = six fires per calendar day (10/11/12/13/14/15 local).
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>13</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!--
      If the Mac was asleep during a scheduled hour, launchd will fire the
      job once when the system next wakes. The wrapper's per-day flag still
      protects against double-running on the same day, so this is safe.
      We don't set RunAtLoad/StartOnMount — those would fire the engine on
      every login/disk-mount, which is too aggressive.
    -->
    <key>RunAtLoad</key>
    <false/>
    <key>StartOnMount</key>
    <false/>

    <!-- launchd's own stdout/stderr capture; the wrapper also writes its own log. -->
    <key>StandardOutPath</key>
    <string>__KB_ROOT__/_engine/_logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__KB_ROOT__/_engine/_logs/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__KB_ROOT__</string>
</dict>
</plist>
